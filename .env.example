# Copie para .env e preencha. O .env não é versionado.

# Chave de API do Google Books (gratuita):
# https://console.cloud.google.com/apis/library/books.googleapis.com
VITE_GOOGLE_BOOKS_API_KEY=

# Config do Firebase (console > Configurações do projeto > Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail do admin (único que pode adicionar/editar/remover livros).
# Deve ser o mesmo e-mail usado em firestore.rules.
VITE_ADMIN_EMAIL=